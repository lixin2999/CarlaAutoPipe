{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://carlaautopipe/schemas/map.schema.json",
  "title": "CARLA Map Asset Manifest",
  "type": "object",
  "required": ["target_carla", "map"],
  "additionalProperties": false,
  "properties": {
    "target_carla": {
      "type": "string",
      "enum": ["0.9.16"]
    },
    "map": {
      "type": "object",
      "required": ["map_name", "xodr_path", "terrain_fbx_path", "navmesh_settings"],
      "additionalProperties": false,
      "properties": {
        "map_name": { "type": "string", "pattern": "^Town[0-9]{2}([A-Za-z0-9_]*)$", "description": "CARLA 地图命名规范 TownXX" },
        "track": { "type": "string", "enum": ["standard", "custom_material", "simple"], "default": "standard", "description": "地图分轨：标准轨/自定义材质轨/简模轨" },
        "xodr_path": { "type": "string", "minLength": 1, "description": "OpenDRIVE 路网文件（相对仓库根或绝对路径，跨平台正斜杠）" },
        "terrain_fbx_path": { "type": "string", "minLength": 1, "description": "地形 FBX 文件" },
        "texture_dir": { "type": "string", "description": "纹理目录（自定义材质轨必填校验项）" },
        "mesh": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string", "enum": ["cm"] },
            "forward_axis": { "type": "string", "enum": ["+X", "-Y"] },
            "up_axis": { "type": "string", "enum": ["+Z"] }
          }
        },
        "navmesh_settings": {
          "type": "object",
          "required": ["enable_vehicle_nav", "enable_pedestrian_nav"],
          "additionalProperties": false,
          "properties": {
            "enable_vehicle_nav": { "type": "boolean", "description": "第一阶段：车辆导航网格（车道边界）" },
            "enable_pedestrian_nav": { "type": "boolean", "description": "第二阶段：行人导航网格（人行道），须在道具就绪后生成" },
            "agent_radius_cm": { "type": "number", "exclusiveMinimum": 0, "default": 30 },
            "agent_height_cm": { "type": "number", "exclusiveMinimum": 0, "default": 180 },
            "max_climb_cm": { "type": "number", "exclusiveMinimum": 0, "default": 30 }
          }
        },
        "material_adapt": { "type": "boolean", "default": true, "description": "自定义材质轨应设为 false 关闭自动材质适配" },
        "simple_collision": { "type": "boolean", "default": false, "description": "简模轨跳过高精度碰撞" }
      }
    }
  }
}
